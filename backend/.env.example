HOST=0.0.0.0
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# mock | proxmox
DASHBOARD_DATA_SOURCE=mock

# Required only when DASHBOARD_DATA_SOURCE=proxmox.
PROXMOX_API_URL=https://proxmox.example.local:8006
PROXMOX_TOKEN_ID=dashboard@pve!jarvis-readonly
PROXMOX_TOKEN_SECRET=replace-with-token-secret
PROXMOX_NODE_NAME=pve

# Keep true when the Proxmox certificate is trusted. Set false only for a
# self-signed certificate on a trusted private network.
PROXMOX_TLS_REJECT_UNAUTHORIZED=true
