HOST=0.0.0.0
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# mock | proxmox
DASHBOARD_DATA_SOURCE=mock

# Required only when DASHBOARD_DATA_SOURCE=proxmox.
PROXMOX_API_URL=https://proxmox.example.local:8006
PROXMOX_WEB_URL=https://proxmox.example.local:8006
PROXMOX_TOKEN_ID=dashboard@pve!jarvis-readonly
PROXMOX_TOKEN_SECRET=replace-with-token-secret
PROXMOX_NODE_NAME=pve

# Keep true when the Proxmox certificate is trusted. Set false only for a
# self-signed certificate on a trusted private network.
PROXMOX_TLS_REJECT_UNAUTHORIZED=true
PROXMOX_RESTART_ENABLED=false

# Host warning thresholds. CPU usage must stay above its threshold for the
# configured duration before a warning is raised.
HOST_ALERT_CPU_WARNING_PERCENT=85
HOST_ALERT_CPU_CRITICAL_PERCENT=95
HOST_ALERT_CPU_SUSTAIN_SECONDS=300
HOST_ALERT_CPU_TEMP_WARNING_C=80
HOST_ALERT_CPU_TEMP_CRITICAL_C=90
HOST_ALERT_MEMORY_WARNING_PERCENT=90
HOST_ALERT_MEMORY_CRITICAL_PERCENT=96
HOST_ALERT_MEMORY_AVAILABLE_WARNING_GIB=1
HOST_ALERT_MEMORY_AVAILABLE_CRITICAL_GIB=0.5
HOST_ALERT_DISK_FREE_WARNING_PERCENT=10
HOST_ALERT_DISK_FREE_CRITICAL_PERCENT=5
HOST_ALERT_SSD_TEMP_WARNING_C=60
HOST_ALERT_SSD_TEMP_CRITICAL_C=70
